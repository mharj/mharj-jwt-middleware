{
  "name": "mharj-jwt-middleware",
  "version": "0.2.0",
  "description": "JWT ExpressJS middleware",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "default": "./dist/index.mjs"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format cjs,esm --dts --clean -c tsconfig.build.json",
    "test": "vitest --run --coverage",
    "prepublishOnly": "npm run build",
    "lint": "biome check",
    "validate": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "repository": "github:mharj/mharj-jwt-middleware",
  "keywords": [
    "jwt",
    "jsonwebtoken",
    "openid",
    "util",
    "aad"
  ],
  "author": "mharj",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mharj/mharj-jwt-middleware/issues"
  },
  "homepage": "https://github.com/mharj/mharj-jwt-middleware#readme",
  "devDependencies": {
    "@avanio/expire-cache": "^0.7.0",
    "@avanio/logger-like": "^0.2.13",
    "@azure/identity": "^4.14.0",
    "@azure/identity-vscode": "^2.2.2",
    "@biomejs/biome": "^2.5.15",
    "@luolapeikko/oidc-jwt-verify": "^0.2.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "c8": "^12.0.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@avanio/logger-like": ">= 0.1.0",
    "@luolapeikko/oidc-jwt-verify": ">= 0.1.2",
    "@types/express": ">= 4.0.0",
    "@types/jsonwebtoken": "^9",
    "express": ">= 4.0.0",
    "jsonwebtoken": "^9"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
