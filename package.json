{
  "name": "mharj-jwt-middleware",
  "version": "0.1.1",
  "description": "JWT ExpressJS middleware",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "default": "./dist/index.mjs"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format cjs,esm --dts --clean -c tsconfig.build.json",
    "test": "vitest --run --coverage",
    "prepublishOnly": "npm run build",
    "lint": "biome check",
    "validate": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mharj/mharj-jwt-middleware.git"
  },
  "keywords": [
    "jwt",
    "jsonwebtoken",
    "openid",
    "util",
    "aad"
  ],
  "author": "mharj",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mharj/mharj-jwt-middleware/issues"
  },
  "homepage": "https://github.com/mharj/mharj-jwt-middleware#readme",
  "devDependencies": {
    "@avanio/expire-cache": "^0.6.10",
    "@avanio/logger-like": "^0.2.12",
    "@azure/identity": "^4.13.1",
    "@azure/identity-vscode": "^2.2.0",
    "@biomejs/biome": "^2.5.5",
    "@types/express": "^4.17.25",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "c8": "^12.0.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "prettier": "^3.9.6",
    "source-map-support": "^0.5.21",
    "tsdown": "^0.22.13",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@avanio/logger-like": ">= 0.1.0",
    "@luolapeikko/oidc-jwt-verify": ">= 0.1.2",
    "express": ">= 4.0.0",
    "jsonwebtoken": "^9"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
}
