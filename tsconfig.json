{
	"compilerOptions": {
		"module": "esnext",
		"target": "ES2020",
		"lib": ["ES2020", "dom"],
		"rootDir": ".",
		"outDir": "./dist",
		"moduleResolution": "bundler",
		"sourceRoot": "./src",
		"types": ["node"],
		"declaration": true,
		"removeComments": false,
		"inlineSources": false,
		"inlineSourceMap": true,
		"forceConsistentCasingInFileNames": true,
		"noImplicitReturns": true,
		"noImplicitThis": true,
		"noImplicitAny": true,
		"importHelpers": false,
		"strictNullChecks": true,
		"noUnusedLocals": true,
		"strict": true,
	},
	"importHelpers": false,
	"exclude": ["dist", "node_modules"],
	"include": ["src", "test"],
}
